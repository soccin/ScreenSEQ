#!/usr/bin/env python3
"""Scanner for FASTQ files to identify target sequences and flanking adapters.

This script scans FASTQ files for target sequences and reports flanking adapter
sequences commonly found in CRISPR screening libraries. It provides intelligent
stopping criteria and configurable parameters for robust adapter discovery.
"""

import argparse
import sys
from typing import Iterator

from tools.FASTQ import read_FASTQ


class ScannerError(Exception):
    """Base exception for scanner-related errors."""


class SequenceFileError(ScannerError):
    """Raised when there are issues with the sequence file."""


class FastqProcessingError(ScannerError):
    """Raised when there are issues processing the FASTQ file."""


def create_argument_parser() -> argparse.ArgumentParser:
    """Create and configure the argument parser.
    
    Creates an ArgumentParser with all necessary command-line options for
    the scanner tool, including sequence file, FASTQ file, and various
    performance and output control parameters.
    
    Returns:
        Configured ArgumentParser instance ready for parsing command-line arguments.
        
    Example:
        Basic usage:
        ```python
        parser = create_argument_parser()
        args = parser.parse_args(['sequences.txt', 'reads.fastq'])
        ```
    """
    parser = argparse.ArgumentParser(
        description="Scan FASTQ files for target sequences and report flanking adapters"
    )
    parser.add_argument(
        'seqFile', 
        type=str, 
        help="File of target sequences"
    )
    parser.add_argument(
        'fastq', 
        type=str, 
        help="FASTQ file"
    )
    parser.add_argument(
        '--max-hits', 
        type=int, 
        default=100, 
        help="Maximum number of hits to find (default: 100)"
    )
    parser.add_argument(
        '--max-reads', 
        type=int, 
        default=0, 
        help="Maximum FASTQ reads to process (0=unlimited, default: 0)"
    )
    parser.add_argument(
        '--min-hit-rate', 
        type=float, 
        default=0.001, 
        help="Minimum hit rate to continue scanning (default: 0.001)"
    )
    parser.add_argument(
        '--flanking-length', 
        type=int, 
        default=20, 
        help="Length of flanking sequences to extract (default: 20)"
    )
    parser.add_argument(
        '--verbose', 
        action='store_true', 
        help="Show progress information to stderr"
    )
    parser.add_argument(
        '--quiet', 
        action='store_true', 
        help="Suppress all non-essential output"
    )
    return parser


def load_target_sequences(seq_file: str, quiet: bool = False) -> list[str]:
    """Load target sequences from file.
    
    Reads a file containing target sequences, one per line, and returns them
    as a list. Empty lines and whitespace are stripped.
    
    Args:
        seq_file: Path to file containing target sequences (one per line).
        quiet: If True, suppress informational output to stderr.
        
    Returns:
        List of target sequences with whitespace stripped.
        
    Raises:
        SequenceFileError: If file cannot be found or read.
        
    Example:
        ```python
        sequences = load_target_sequences('targets.txt')
        # Returns: ['ATCGATCG', 'GCTAGCTA', ...]
        ```
    """
    try:
        with open(seq_file, "r") as f:
            sequences = [line.strip() for line in f.readlines()]
        if not quiet:
            print(f"# Loaded {len(sequences)} target sequences from {seq_file}", file=sys.stderr)
        return sequences
    except FileNotFoundError:
        raise SequenceFileError(f"Cannot find sequence file: {seq_file}")
    except Exception as e:
        raise SequenceFileError(f"Cannot read sequence file {seq_file}: {e}")


def extract_flanking_sequences(
    sequence: str, 
    position: int, 
    target_length: int, 
    flanking_length: int
) -> tuple[str, str]:
    """Extract flanking sequences around a target sequence.
    
    Extracts sequences upstream (5') and downstream (3') of a target sequence
    found at a specific position. If the flanking sequences are shorter than
    requested, they are padded with 'N' characters.
    
    Args:
        sequence: The full sequence containing the target.
        position: Position where target sequence was found (0-based).
        target_length: Length of the target sequence.
        flanking_length: Desired length of flanking sequences.
        
    Returns:
        Tuple of (5' flanking sequence, 3' flanking sequence), both of
        length `flanking_length` (padded with 'N' if necessary).
        
    Example:
        ```python
        seq = "AAAATCGATCGAAAA"
        pos = 4
        target_len = 8
        flank_5p, flank_3p = extract_flanking_sequences(seq, pos, target_len, 3)
        # Returns: ('AAA', 'AAA')
        ```
    """
    # Calculate boundaries
    start_5p = max(0, position - flanking_length)
    end_5p = position
    start_3p = position + target_length
    end_3p = min(len(sequence), start_3p + flanking_length)
    
    # Extract sequences
    seq_5p = sequence[start_5p:end_5p]
    seq_3p = sequence[start_3p:end_3p]
    
    # Pad with N if sequences are too short
    if len(seq_5p) < flanking_length:
        seq_5p = "N" * (flanking_length - len(seq_5p)) + seq_5p
    if len(seq_3p) < flanking_length:
        seq_3p = seq_3p + "N" * (flanking_length - len(seq_3p))
    
    return seq_5p, seq_3p


def scan_fastq_for_targets(
    fastq_file: str,
    target_sequences: list[str],
    *,
    max_hits: int = 100,
    max_reads: int = 0,
    min_hit_rate: float = 0.001,
    flanking_length: int = 20,
    verbose: bool = False,
    quiet: bool = False
) -> tuple[int, int]:
    """Scan FASTQ file for target sequences and report flanking adapters.
    
    Args:
        fastq_file: Path to FASTQ file to scan.
        target_sequences: List of target sequences to search for.
        max_hits: Maximum number of hits to find before stopping.
        max_reads: Maximum FASTQ reads to process (0=unlimited).
        min_hit_rate: Minimum hit rate to continue scanning.
        flanking_length: Length of flanking sequences to extract.
        verbose: Show progress information to stderr.
        quiet: Suppress all non-essential output.
        
    Returns:
        Tuple of (total_reads_processed, total_hits_found).
        
    Raises:
        FastqProcessingError: If there are issues processing the FASTQ file.
    """
    hit_count = 0
    reads_processed = 0
    
    try:
        for read_record in read_FASTQ(fastq_file):
            reads_processed += 1
            
            # Check read limit
            if max_reads > 0 and reads_processed > max_reads:
                if verbose:
                    print(f"# Stopped: reached max reads limit ({max_reads})", file=sys.stderr)
                break
                
            # Check hit rate every 10,000 reads (after initial warm-up)
            if reads_processed > 10000 and reads_processed % 10000 == 0:
                hit_rate = hit_count / reads_processed
                if hit_rate < min_hit_rate:
                    if verbose:
                        print(f"# Stopped: hit rate {hit_rate:.6f} below threshold {min_hit_rate}", file=sys.stderr)
                    break
                    
            # Progress reporting
            if verbose and reads_processed % 50000 == 0:
                hit_rate = hit_count / reads_processed if reads_processed > 0 else 0
                print(f"# Progress: {reads_processed} reads processed, {hit_count} hits found, hit rate: {hit_rate:.6f}", file=sys.stderr)
            
            # Check if we've found enough hits
            if hit_count >= max_hits:
                if verbose:
                    print(f"# Stopped: reached max hits limit ({max_hits})", file=sys.stderr)
                break
                
            # Scan current read for target sequences
            for target_seq in target_sequences:
                if hit_count >= max_hits:
                    break
                    
                pos = read_record.seq.find(target_seq)
                if pos > -1:
                    # Extract flanking sequences using helper function
                    seq_5p, seq_3p = extract_flanking_sequences(
                        read_record.seq, pos, len(target_seq), flanking_length
                    )
                    
                    print(f"#SCAN# {target_seq} {pos} 5': {seq_5p} 3': {seq_3p}")
                    sys.stdout.flush()
                    hit_count += 1
                    
    except KeyboardInterrupt:
        if not quiet:
            print("# Interrupted by user", file=sys.stderr)
        raise
    except Exception as e:
        raise FastqProcessingError(f"Error processing FASTQ file {fastq_file}: {e}")
    
    return reads_processed, hit_count


def main() -> None:
    """Main entry point for the scanner script."""
    # Parse command line arguments
    parser = create_argument_parser()
    args = parser.parse_args()
    
    try:
        # Validate arguments and report starting parameters
        if not args.quiet:
            print(f"# Scanner starting with parameters: max-hits={args.max_hits}, "
                  f"max-reads={args.max_reads}, min-hit-rate={args.min_hit_rate}", 
                  file=sys.stderr)
        
        # Load target sequences
        target_sequences = load_target_sequences(args.seqFile, args.quiet)
        
        # Scan FASTQ file for target sequences
        reads_processed, hit_count = scan_fastq_for_targets(
            args.fastq,
            target_sequences,
            max_hits=args.max_hits,
            max_reads=args.max_reads,
            min_hit_rate=args.min_hit_rate,
            flanking_length=args.flanking_length,
            verbose=args.verbose,
            quiet=args.quiet
        )
        
        # Final summary
        if not args.quiet:
            hit_rate = hit_count / reads_processed if reads_processed > 0 else 0
            print(f"# Scan complete: {reads_processed} reads processed, {hit_count} hits found", file=sys.stderr)
            print(f"# Final hit rate: {hit_rate:.6f}", file=sys.stderr)
            
    except (SequenceFileError, FastqProcessingError) as e:
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        if not args.quiet:
            print("# Interrupted by user", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()


